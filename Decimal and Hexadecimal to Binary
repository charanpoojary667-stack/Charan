#include <stdio.h>

int main() {
    int ch, dec, bin[32], i = 0;
    unsigned int hex;

    printf("1. Decimal to Binary\n2. Hexadecimal to Binary\n");
    printf("Enter choice: ");
    scanf("%d", &ch);

    if (ch == 1) {
        printf("Enter decimal number: ");
        scanf("%d", &dec);

        while (dec > 0) {
            bin[i++] = dec % 2;
            dec /= 2;
        }
    } else if (ch == 2) {
        printf("Enter hexadecimal number: ");
        scanf("%x", &hex);

        while (hex > 0) {
            bin[i++] = hex % 2;
            hex /= 2;
        }
    } else {
        printf("Invalid choice");
        return 0;
    }

    printf("Binary = ");
    for (i = i - 1; i >= 0; i--)
        printf("%d", bin[i]);

    return 0;
}
