#include <stdio.h>
#include <string.h>

int main() {
    char bin[50];
    int i, len, carry = 1;

    printf("Enter a binary number: ");
    scanf("%s", bin);

    len = strlen(bin);

    for (i = 0; i < len; i++) {
        if (bin[i] == '0')
            bin[i] = '1';
        else
            bin[i] = '0';
    }

    for (i = len - 1; i >= 0; i--) {
        if (carry == 0)
            break;

        if (bin[i] == '0') {
            bin[i] = '1';
            carry = 0;
        } else {
            bin[i] = '0';
            carry = 1;
        }
    }

    printf("2's Complement = %s\n", bin);

    return 0;
}
