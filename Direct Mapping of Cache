#include <stdio.h>

int main()
{
    int cache[10];
    int n, block, line, accesses;

    printf("Enter number of cache lines: ");
    scanf("%d", &n);

    for (int i = 0; i < n; i++)
    {
        cache[i] = -1;
    }

    printf("Enter number of memory accesses: ");
    scanf("%d", &accesses);

    printf("\nEnter memory block number: ");
    scanf("%d", &block);

    line = block % n;

    printf("Block %d -> Cache Line %d\n", block, line);

    if (cache[line] == block)
    {
        printf("Cache Hit\n");
    }
    else
    {
        printf("Cache Miss\n");
        cache[line] = block;
    }

    printf("Cache Contents:\n");

    for (int j = 0; j < n; j++)
    {
        if (cache[j] == -1)
        {
            printf("Cache Line %d : Empty\n", j);
        }
        else
        {
            printf("Cache Line %d : Block %d\n", j, cache[j]);
        }
    }

    return 0;
}
