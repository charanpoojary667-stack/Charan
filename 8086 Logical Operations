.MODEL SMALL
.STACK 100H

.DATA
    NUM1 DB 55H
    NUM2 DB 0FH
    AND_RESULT DB ?
    OR_RESULT DB ?
    XOR_RESULT DB ?
    NOT_RESULT DB ?

.CODE

MAIN PROC

    MOV AX, @DATA
    MOV DS, AX

    MOV AL, NUM1
    AND AL, NUM2
    MOV AND_RESULT, AL

    MOV AL, NUM1
    OR AL, NUM2
    MOV OR_RESULT, AL

    MOV AL, NUM1
    XOR AL, NUM2
    MOV XOR_RESULT, AL

    MOV AL, NUM1
    NOT AL
    MOV NOT_RESULT, AL

    MOV AH, 4CH
    INT 21H

MAIN ENDP
END MAIN
